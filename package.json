{
  "name": "freelance-tax-mcp",
  "version": "1.4.0",
  "mcpName": "io.github.NarwhalThePong/freelance-tax-mcp",
  "description": "MCP server for US freelancer taxes in 2026: quarterly estimated tax, self-employment tax (Schedule SE with Additional Medicare), the Section 199A QBI deduction (Form 8995/8995-A), freelance hourly rate, IRS due dates, mileage, home office, SEP IRA vs Solo 401(k), and GSA per diem rates with the self-employed meal deduction. Runs locally, no API key, no network.",
  "type": "module",
  "bin": {
    "freelance-tax-mcp": "src/server.js"
  },
  "main": "src/tools.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tax",
    "freelancer",
    "self-employment-tax",
    "estimated-tax",
    "1040-es",
    "irs",
    "mileage",
    "home-office",
    "sep-ira",
    "solo-401k",
    "retirement",
    "per-diem",
    "gsa",
    "meal-deduction",
    "travel",
    "schedule-se",
    "additional-medicare-tax",
    "hourly-rate",
    "freelance-rate",
    "qbi",
    "qbi-deduction",
    "section-199a",
    "form-8995"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "repository": {
