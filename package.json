{
  "name": "freelance-tax-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.NarwhalThePong/freelance-tax-mcp",
  "description": "MCP server for US freelancer taxes in 2026: quarterly estimated tax, self-employment tax, IRS due dates, mileage and home office deductions. Runs locally, no API key, no network.",
